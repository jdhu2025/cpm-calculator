PORT=4173

# The public HTTPS URL used by canonical tags, sitemap.xml, robots.txt and schema.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Copy this file to .env.local for local development, or add the same names in Vercel Project Settings.
# Fill these values to enable a real OpenAI-compatible AI provider.
# Leave them blank to use the built-in local estimate fallback.
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b:free
AI_TIMEOUT_MS=20000
